# =============================================================================
# ConnectCG Frontend (React + Vite) - Environment Configuration
# File mẫu cấu hình biến môi trường cho Frontend (KHÔNG chứa secret thật)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. API BACKEND & WEBSOCKET ENDPOINTS
# -----------------------------------------------------------------------------
# Base URL trỏ vào Backend Spring Boot (đồng bộ tiền tố /api/v1)
# - Local: http://localhost:8080/api/v1
# - Production: https://connect-api.quizken.com/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1

# WebSocket STOMP endpoint qua SockJS
# - Local: http://localhost:8080/ws
# - Production: https://connect-api.quizken.com/ws
VITE_WS_URL=http://localhost:8080/ws

# -----------------------------------------------------------------------------
# 2. OAUTH2 SOCIAL LOGIN ENDPOINTS
# -----------------------------------------------------------------------------
# Endpoint điều hướng đăng nhập mạng xã hội
# - Local: http://localhost:8080/oauth2/authorization/...
# - Production: https://connect-api.quizken.com/oauth2/authorization/...
VITE_OAUTH2_GOOGLE_URL=http://localhost:8080/oauth2/authorization/google
VITE_OAUTH2_FACEBOOK_URL=http://localhost:8080/oauth2/authorization/facebook

# -----------------------------------------------------------------------------
# 3. FIREBASE REALTIME DATABASE (REALTIME CHAT)
# -----------------------------------------------------------------------------
# Cấu hình Firebase Realtime Database phục vụ tính năng nhắn tin tức thời
# Điền thông tin dự án Firebase của bạn tại https://console.firebase.google.com
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# -----------------------------------------------------------------------------
# 4. MOCK DATA & DEVELOPMENT FLAGS
# -----------------------------------------------------------------------------
# Chế độ Mock dữ liệu nội bộ (false: gọi API thật, true: dùng mock data MSW)
VITE_USE_MOCK=false
