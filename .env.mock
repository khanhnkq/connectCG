# =============================================================================
# ConnectCG Frontend - Standalone Mock Mode Environment
# =============================================================================

# Kích hoạt Standalone Mock Layer (Không cần backend Spring Boot)
VITE_USE_MOCK=true

# Base URL giả lập (tự động xử lý bởi Axios Mock Adapter)
VITE_API_BASE_URL=/api/v1

# WebSocket giả lập (tự động xử lý bởi MockStompClient)
VITE_WS_URL=/ws

# OAuth2 Endpoints giả lập
VITE_OAUTH2_GOOGLE_URL=/login
VITE_OAUTH2_FACEBOOK_URL=/login
