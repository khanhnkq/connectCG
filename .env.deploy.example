# =============================================================================
# ConnectCG Frontend - Production Deployment Configuration
# File mẫu cấu hình biến môi trường khi triển khai Frontend lên Vercel / Cloudflare Pages / VPS
# =============================================================================

DEPLOY_TARGET='vps'
FRONTEND_IMAGE='ghcr.io/khanhnkq/connectcg-frontend'
FRONTEND_TAG='latest'
SERVICE_BIND_ADDRESS='127.0.0.1'
FRONTEND_PORT='3000'
HEALTHCHECK_URL='http://127.0.0.1:3000/healthz'
VERCEL_PROJECT='connectcg'

# --- API & WebSocket Endpoints ---
VITE_API_BASE_URL='https://connect-api.quizken.com/api/v1'
VITE_WS_URL='https://connect-api.quizken.com/ws'
VITE_OAUTH2_GOOGLE_URL='https://connect-api.quizken.com/oauth2/authorization/google'
VITE_OAUTH2_FACEBOOK_URL='https://connect-api.quizken.com/oauth2/authorization/facebook'
VITE_USE_MOCK='false'

# --- Firebase Realtime Database (Chat Realtime) ---
VITE_FIREBASE_API_KEY='your_firebase_api_key_here'
VITE_FIREBASE_AUTH_DOMAIN='your_project_id.firebaseapp.com'
VITE_FIREBASE_DATABASE_URL='https://your_project_id-default-rtdb.firebaseio.com'
VITE_FIREBASE_PROJECT_ID='your_project_id'
VITE_FIREBASE_STORAGE_BUCKET='your_project_id.firebasestorage.app'
VITE_FIREBASE_MESSAGING_SENDER_ID='your_messaging_sender_id'
VITE_FIREBASE_APP_ID='your_firebase_app_id'
VITE_FIREBASE_MEASUREMENT_ID='your_measurement_id'
